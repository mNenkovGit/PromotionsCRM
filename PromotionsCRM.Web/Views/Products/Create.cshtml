@using PromotionsCRM.ViewModels.Products
@model ProductCreateViewModel

@{
    ViewBag.Title = $"Add Product to @{Model.PromotionName}";

}

<h2 class="text-center">Add Product to @Model.PromotionName</h2>
<hr />

<div class="row">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Product Name</label>
                <input asp-for="Name" class="form-control" aria-required="true" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            
            <div class="mb-3">
                <input type="hidden" asp-for="PromotionId" />
                <p>Promotion: <strong>@Model.PromotionName</strong></p>
            </div>

            <div class="mb-3">
                <input class="btn btn-warning mb-2 w-100 py-3 fw-bold rounded"
                       type="submit" value="Save" />
            </div>
            <a asp-controller="Promotions" asp-action="Details" asp-route-id="@Model.PromotionId" class="btn btn-secondary mb-2 w-100 py-3 fw-bold rounded">
                Cancel
            </a>
            
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

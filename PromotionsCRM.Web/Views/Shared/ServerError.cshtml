@{
    ViewData["Title"] = "Server Error";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 text-center p-4">
            <div class="card-body">

                <div class="display-1 fw-bold mb-2" style="color: var(--coral);">500</div>

                <h2 class="fw-bold mb-3">Something Went Wrong</h2>

                <p class="text-muted mb-4">
                    We're sorry for the inconvenience. An unexpected error occurred on our server.
                    Please try again later.
                </p>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-warning btn-lg">
                    Back to Home
                </a>

            </div>
        </div>
    </div>
</div>
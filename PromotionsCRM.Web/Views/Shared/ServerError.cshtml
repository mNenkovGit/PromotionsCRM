@{
    ViewData["Title"] = "Server Error (500)";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h1 class="display-1 fw-bold text-danger">500</h1>
            <h2 class="mb-3">Something Went Wrong</h2>
            <p class="text-muted mb-4">
                We're sorry for the inconvenience. An unexpected error occurred on our server. Please try again later.
            </p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">
                Back to Home
            </a>
        </div>
    </div>
</div>
@using PromotionsCRM.Web.Data.Enums
@using PromotionsCRM.Web.ViewModels.Promotions
@model PromotionCreateViewModel 

@{
    ViewBag.Title = "Create Promotion";
    
}

<h2 class="text-center">Create Promotion</h2>
<hr />

<div class="row">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Promotion Name</label>
                <input asp-for="Name" class="form-control" aria-required="true" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">Start Date</label>
                <input asp-for="StartDate" class="form-control" aria-required="true" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label">End Date</label>
                <input asp-for="EndDate" class="form-control" aria-required="true" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PromotionType" class="form-label">Promotion Type</label>
                <select asp-for="PromotionType" class="form-select" aria-required="true" 
                        asp-items="Html.GetEnumSelectList<PromotionType>()">
                    <option value="">Select Promotion Type...</option>
                    </select>
                    <span asp-validation-for="PromotionType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ClientId" class="form-label">Select Client</label>
                <select asp-for="ClientId" class="form-select" aria-required="true"
                        asp-items="Model.Clients">
                    <option value="">Select Client...</option>
                </select>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input class="btn btn-warning mb-2 w-100 py-3 fw-bold rounded"
                       type="submit" value="Save" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

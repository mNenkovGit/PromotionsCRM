@using PromotionsCRM.Data.Models
@using PromotionsCRM.Web.ViewModels.Promotions
@model PromotionDetailsViewModel


<h2>Promotion Overview</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>

        <p class="card-text mb-1"><strong>Id:</strong> @Model.Id</p>
        <p class="card-text mb-1"><strong>Promotion Name:</strong> @Model.Name</p>
        <p class="card-text mb-1"><strong>Start Date:</strong> @Model.StartDate.ToString("dd/MM/yyyy")</p>
        <p class="card-text mb-1"><strong>End Date:</strong> @Model.EndDate.ToString("dd/MM/yyyy")</p>
        <p class="card-text mb-1"><strong>Promotion Status:</strong> @Model.PromotionStatus</p>
        <p class="card-text mb-1"><strong>Promotion Type:</strong> @Model.PromotionType</p>
        <p class="card-text mb-1"><strong>Client Name:</strong> <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId">@Model.ClientName</a></p>
        <p class="card-text mb-1"><strong>Promotion Countries:</strong> @(string.Join(", ", Model.Countries))</p>
        <p class="card-text mb-1"><strong>Promotion Products:</strong> @string.Join(", ", Model.Products)</p>
        <h5 class="mt-4">
            Submission Statuses:</h5>
            @if (Model.SubmissionsByStatus.Any())
            {
                <table class="table table-sm table-striped w-auto">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SubmissionsByStatus)
                    {
                        <tr>

                            <td>@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }    
                </tbody>
                </table>
            }
            else
            {
                <p>No submissions yet!</p>
            }

        
       
    <a asp-controller="Promotions"
       asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning mt-3">
        Edit
    </a>
    <a asp-controller="Promotions"
       asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger mt-3">
        Delete
    </a>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Promotions" asp-action="Index">Back to Promotions</a>
</div>
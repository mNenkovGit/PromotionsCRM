@using PromotionsCRM.Web.ViewModels.Promotions
@model PromotionDeleteViewModel
@{
    ViewBag.Title = "Delete Promotion";
}
<h2 class="text-center">Delete Promotion</h2>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center">
                <h3 class="card-title">@Model.Name</h3>

                
            </div>

            <div class="card-footer text-center">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    @if (Model.HasSubmissions == true)
                    {
                        <p class="text-warning mt-3">
                            There are already submited registrations for this promotion! Delete Action is denied!
                        </p>
                        <div class="mt-3">
                            <a asp-controller="Promotions" asp-action="Index">Back to Promotions</a>
                        </div>
                    }
                    else
                    {
                        if (Model.ProductsCount > 0)
                        {
                            <p class="text-warning mt-3">
                                @Model.ProductsCount Product(s) will be deleted!
                            </p>
                        }

                        <p class="text-danger mt-3">
                            Are you sure you want to delete this promotion?
                        </p>
                        <button type="submit" class="btn btn-danger me-2">
                            Confirm Delete
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            Cancel
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
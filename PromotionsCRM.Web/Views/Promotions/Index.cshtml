@using PromotionsCRM.ViewModels.Promotions
@model IEnumerable<PromotionViewModel>

@{
    ViewBag.Title = "Promotions";
}

<h2 class="text-center">Promotions</h2>

<form asp-controller="Promotions" asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input name="name" class="form-control" placeholder="Search by name (e.g. Promotion Name 123...)" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>

</form>

@if (!Model.Any())
{
    <p>No Promotions found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Promotion Type</th>
                <th>Promotion Status</th>
                <th>Client</th>
                <th>Number of Submissions</th>
                <th></th>
             </tr>
        </thead>
        <tbody>
            @foreach (var promotion in Model)
            {
                <tr>
                    <td>@promotion.Id</td>
                    <td>@promotion.Name</td>
                    <td>@promotion.StartDate.ToString("dd/MM/yyyy")</td>
                    <td>@promotion.EndDate.ToString("dd/MM/yyyy")</td>
                    <td>@promotion.PromotionType</td>
                    <td><partial name="_PromotionStatusBadge" model="promotion.PromotionStatus" /></td>
                    <td>@promotion.ClientName</td>
                    <td>@promotion.SubmissionCount</td>
                    <td class="text-nowrap">
                        <div class="d-flex gap-1">
                            <a ... class="btn btn-sm btn-info">Details</a>
                            <a ... class="btn btn-sm btn-warning">Edit</a>
                            <a ... class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
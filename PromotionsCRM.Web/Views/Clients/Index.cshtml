@using PromotionsCRM.Web.ViewModels.Clients
@model IEnumerable<ClientViewModel>
@{
    ViewBag.Title = "Clients";
}

<h2>@ViewBag.Title</h2>

<div class="text-center">
    <p></p>
    

</div>
<form asp-controller="Clients" asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input name="name" class="form-control" placeholder="Search by name (e.g. Client Name 123...)" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <p>No clients found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Website</th>
                <th>Country</th>
                <th></th>

            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.Name</td>
                    <td>@client.Email</td>
                    <td>@client.PhoneNumber</td>
                    <td><a href="@client.Website" target="_blank">@client.Website</a></td>
                    <td>@client.Country</td>

                    <td>
                        <a asp-controller="Clients"
                           asp-action="Details"
                           asp-route-id="@client.Id"
                           class="btn btn-warning">
                            Details
                        </a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}
@using PromotionsCRM.Web.ViewModels.Clients
@model ClientDetailsViewModel

<h2>Client Details</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>

        <p class="card-text mb-1"><strong>Address:</strong> @Model.Address</p>
        <p class="card-text mb-1"><strong>Email:</strong> @Model.Email</p>
        <p class="card-text mb-1"><strong>Phone Number:</strong> @Model.PhoneNumber</p>
        <p class="card-text mb-1"><strong>Registered On:</strong> @Model.RegisteredOn</p>
        <p class="card-text mb-1"><strong>Website:</strong> <a href="@Model.Website" target="_blank">@Model.Website</a></p>
        <p class="card-text mb-1"><strong>Country:</strong> @Model.Country</p>
        <h5>Promotions: </h5>


        <a asp-controller="Promotions"
           asp-action="Create"
           asp-route-clientId="@Model.Id"
           class="btn btn-success mt-2">
            Add Promotion
        </a>
        <p></p>
        <form asp-controller="Promotions" asp-action="Index" method="get" class="mb-3">
            <div class="input-group">
                <input name="name" class="form-control" placeholder="Search by name (e.g. Promotion Name 123...)" />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        @if (Model.Promotions.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Promotion Type</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var promotion in Model.Promotions)
                    {
                        <tr>
                            <td>@promotion.Name</td>
                            <td>@promotion.StartDate.ToString("dd-MM-yyyy")</td>
                            <td>@promotion.EndDate.ToString("dd-MM-yyyy")</td>
                            <td>@promotion.PromotionStatus</td>
                            <td>@promotion.PromotionType</td>
                            

                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <span>No promotions available.</span>
        }

    </div>
</div>

<a asp-controller="Promotions"
   asp-action="Create"
   asp-route-clientId="@Model.Id"
   class="btn btn-success mt-2">
    Add Promotion
</a>

<div class="mt-3">
    <a asp-controller="Clients" asp-action="Index">Back to Clients</a>
</div>
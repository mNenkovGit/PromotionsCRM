@using PromotionsCRM.Data.Models
@model Client


<h2>Client Details</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>

        <p class="card-text mb-1"><strong>Address:</strong> @Model.Address</p>
        <p class="card-text mb-1"><strong>Email:</strong> @Model.Email</p>
        <p class="card-text mb-1"><strong>Phone Number:</strong> @Model.PhoneNumber</p>
        <p class="card-text mb-1"><strong>Registered On:</strong> @Model.RegisteredOn.ToString("yyyy-MM-dd")</p>
        <p class="card-text mb-1"><strong>Website:</strong> <a href="@Model.Website" target="_blank">@Model.Website</a></p>
        <p class="card-text mb-1"><strong>Country:</strong> @Model.Country.Name</p>
        <h5>Promotions: </h5>
            
            @if (Model.Promotions.Any())
            {
                <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                
                    </tr>
                </thead>
                <tbody>
                @foreach (var promotion in Model.Promotions)
                {
                  <tr>    
                    <td>@promotion.Name</td>
                    <td>@promotion.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@promotion.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>
                                @if(promotion.EndDate > DateTime.Today)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if(promotion.StartDate < DateTime.Today)
                                {
                                    <span class="badge bg-warning">Expired</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Upcoming</span>
                                }
                            </td>
                  </tr>
                }
                </tbody>
            </table>
            }
            else
            {
                <span>No promotions available.</span>
            } 
          
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Clients" asp-action="Index">Back to Clients</a>
</div>
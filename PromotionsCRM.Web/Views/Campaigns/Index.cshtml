<div class="row g-3">
    @foreach (var ev in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm offer-card">
                <div class="card-body">

                    <div class="offer-client">@ev.ClientName</div>

                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h5 class="card-title">@ev.Name</h5>

                        <span class="offer-days" data-days-left="@ev.DaysLeft">
                            @(ev.DaysLeft == 0 ? "Last day" : $"{ev.DaysLeft} days left")
                        </span>
                    </div>

                    <ul class="list-unstyled offer-facts">
                        <li><strong>Type:</strong> @ev.PromotionType</li>
                        <li><strong>Period:</strong> @ev.StartDate.ToString("dd/MM/yyyy") – @ev.EndDate.ToString("dd/MM/yyyy")</li>
                        <li><strong>Countries:</strong> @string.Join(", ", ev.Countries)</li>
                        <li><strong>Products:</strong> @string.Join(", ", ev.Products)</li>
                    </ul>
                </div>

                <div class="card-footer">
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary w-100"
                           asp-controller="Campaigns"
                           asp-action="Details"
                           asp-route-id="@ev.Id">
                            Details
                        </a>

                        <a class="btn btn-warning w-100"
                           asp-controller="Campaigns"
                           asp-action="Register"
                           asp-route-promotionId="@ev.Id">
                            Register
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
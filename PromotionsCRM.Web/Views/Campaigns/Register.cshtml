@using PromotionsCRM.ViewModels.Campaigns
@model CampaignRegistrationViewModel

@{
    ViewBag.Title = $"Register for {Model.PromotionName}";
    var maxPurchaseDate = DateTime.Today < Model.EndDate ? DateTime.Today : Model.EndDate;
}

<h2 class="text-center">Register for @Model.PromotionName</h2>
<p class="text-center text-muted">
    Promotion period: @Model.StartDate.ToString("dd/MM/yyyy") – @Model.EndDate.ToString("dd/MM/yyyy")
</p>
<hr />

<div class="row">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="PromotionId" />

            <h5 class="mb-3">Your details</h5>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+359888123456" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CountryId" class="form-label">Country</label>
                <select asp-for="CountryId" asp-items="Model.Countries" class="form-select">
                    <option value="">-- Select country --</option>
                </select>
                <span asp-validation-for="CountryId" class="text-danger"></span>
            </div>

            <h5 class="mt-4 mb-3">Your purchase</h5>

            <div class="mb-3">
                <label asp-for="ProductId" class="form-label">Product</label>
                <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
                    <option value="">-- Select product --</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PurchaseDate" class="form-label">Purchase Date</label>
                <input asp-for="PurchaseDate" class="form-control"
                       min="@Model.StartDate.ToString("yyyy-MM-dd")"
                       max="@maxPurchaseDate.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input class="btn btn-warning mb-2 w-100 py-3 fw-bold rounded" type="submit" value="Register" />
            </div>
            <div class="mb-3">
                <a asp-action="Details" asp-route-id="@Model.PromotionId"
                   class="btn btn-secondary mb-2 w-100 py-3 fw-bold rounded">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
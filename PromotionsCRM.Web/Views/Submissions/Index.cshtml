@using PromotionsCRM.ViewModels.Submissions
@model SubmissionsIndexViewModel

@{
    ViewBag.Title = "Submissions";
}

<h2 class="text-center">Submissions</h2>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-12 col-md-3">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusName>()" class="form-select">
            <option value="">All statuses</option>
        </select>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="PromotionId" class="form-label">Promotion</label>
        <select asp-for="PromotionId" asp-items="Model.Promotions" class="form-select">
            <option value="">All promotions</option>
        </select>
    </div>

    <div class="col-12 col-md-3">
        <label asp-for="Search" class="form-label">Customer</label>
        <input asp-for="Search" class="form-control" placeholder="Name or email" />
    </div>

    <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
        <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
    </div>
</form>

@if (!Model.Submissions.Any())
{
    <p class="text-muted">No Submissions found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Submitted On</th>
                <th>Customer Name</th>
                <th>Email</th>
                <th>Promotion</th>
                <th>Product</th>
                <th>Purchase Date</th>
                <th>Status</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var submission in Model.Submissions)
            {
                <tr>
                    <td>@submission.SubmittedOn.ToString("dd/MM/yyyy")</td>
                    <td>@submission.CustomerName</td>
                    <td>@submission.CustomerEmail</td>
                    <td>@submission.PromotionName</td>
                    <td>@submission.ProductName</td>
                    <td>@submission.PurchaseDate.ToString("dd/MM/yyyy")</td>
                    <td><partial name="_SubmissionStatusBadge" model="submission.Status" /></td>
                    <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@submission.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Submissions pages" class="mt-3">
            <ul class="pagination justify-content-center">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-status="@Model.Status"
                       asp-route-promotionId="@Model.PromotionId"
                       asp-route-search="@Model.Search"
                       asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-status="@Model.Status"
                           asp-route-promotionId="@Model.PromotionId"
                           asp-route-search="@Model.Search"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-status="@Model.Status"
                       asp-route-promotionId="@Model.PromotionId"
                       asp-route-search="@Model.Search"
                       asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>

            </ul>
        </nav>
    }

}
@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="mb-4">
    <h2 class="mb-1">Admin Dashboard</h2>
    <p class="text-muted mb-0">Manage the application using the sections below.</p>
</div>

<div class="row g-3">

    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Users</h5>
                <p class="text-muted">View all users, assign or remove roles and delete accounts.</p>
                <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
                   class="btn btn-outline-primary mt-auto">Manage users</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Submissions</h5>
                <p class="text-muted">Review customer registrations and change their status.</p>
                <a asp-area="" asp-controller="Submissions" asp-action="Index"
                   class="btn btn-outline-primary mt-auto">Go to submissions</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Promotions</h5>
                <p class="text-muted">Create, edit and delete promotions and their products.</p>
                <a asp-area="" asp-controller="Promotions" asp-action="Index"
                   class="btn btn-outline-primary mt-auto">Go to promotions</a>
            </div>
        </div>
    </div>

</div>